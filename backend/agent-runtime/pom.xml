<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.stellarcompact</groupId>
        <artifactId>stellar-compact-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>agent-runtime</artifactId>
    <name>Stellar Compact :: agent-runtime</name>
    <description>Spring AI ChatClient integration. Depends on engine + galaxy.</description>

    <dependencies>
        <dependency>
            <groupId>com.stellarcompact</groupId>
            <artifactId>engine</artifactId>
        </dependency>
        <dependency>
            <groupId>com.stellarcompact</groupId>
            <artifactId>galaxy</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!--
          E4-02 prompt assembly serialises the compact WorldView to deterministic
          JSON for the user message. databind drives the serialisation; the jdk8
          datatype module teaches it the Optional<> fields the WorldView/Action
          records use. Both are already on the runtime classpath transitively (Spring
          AI + Spring Boot pull jackson); declared here explicitly so the prompt
          module's serialisation contract does not silently depend on a transitive.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jdk8</artifactId>
        </dependency>
        <!--
          Ollama is the DEFAULT, pluggable model provider (Spring AI 2.0.0-M8).
          Its presence on the classpath triggers the OllamaChatModel auto-config,
          which feeds the auto-configured ChatClient.Builder our factory consumes.
          Versions come from the parent's spring-ai-bom import; the Spring milestone
          repository (also in the parent pom) resolves the M8 artifacts.
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>

        <!--
          Generates metadata for stellar-compact.agent.* so IDEs offer completion
          and validation on the tier config. Optional: not propagated downstream.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
          Provider neutrality (principle 4): OpenAI is selectable WITHOUT a code
          change. The starter is gated behind this Maven profile so the default
          (Ollama-only) build stays lean and offline-resolvable, while a build that
          wants the hosted provider activates it and then chooses OpenAI at RUNTIME
          via the Spring "openai" profile + spring.ai.openai.* properties. Version
          is managed by the parent's spring-ai-bom (no version pinned here).

          Activate with: mvn -P openai ...
        -->
        <profile>
            <id>openai</id>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.ai</groupId>
                    <artifactId>spring-ai-starter-model-openai</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
