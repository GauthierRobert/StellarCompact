<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.stellarcompact</groupId>
        <artifactId>stellar-compact-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>api</artifactId>
    <name>Stellar Compact :: api</name>
    <description>REST (config/CRUD/tiles) + WebSocket/STOMP live tick stream. Depends on orchestrator + engine.</description>

    <dependencies>
        <dependency>
            <groupId>com.stellarcompact</groupId>
            <artifactId>orchestrator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.stellarcompact</groupId>
            <artifactId>engine</artifactId>
        </dependency>
        <!--
          E6-03: the tile endpoints generate immutable, procedural scenery on
          demand from the seed via the galaxy module's pure generators
          (com.stellarcompact.galaxy.gen.*). Read-only at the code level: the api
          calls the generators, never modifies them. Version is managed by the
          parent reactor's dependencyManagement.
        -->
        <dependency>
            <groupId>com.stellarcompact</groupId>
            <artifactId>galaxy</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!--
          Dev authentication (username-only JWT, see docs/specs/rest-api.md
          "Authentication (dev)"). resource-server decodes/verifies the Bearer token and
          populates the request Principal from the `sub` claim; the oauth2-jose Nimbus
          encoder mints the dev HS256 token. Forward-compatible with Google OAuth: swap the
          decoder's key source (Google JWKS) and the issuer without touching controllers.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
