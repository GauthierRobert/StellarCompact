<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.stellarcompact</groupId>
        <artifactId>stellar-compact-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>engine</artifactId>
    <name>Stellar Compact :: engine</name>
    <description>Pure, deterministic domain: state records, sealed Action, resolver. No Spring, no I/O.</description>

    <dependencies>
        <!--
          Jackson is used ONLY to parse a balance profile from a String the caller
          already holds (pure: ObjectMapper.readValue(String, ...)). The engine
          never reads a stream/file/URL itself, so no java.io / java.net leaks in.
          Version managed by the Spring Boot BOM imported in the parent reactor.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!--
          Jdk8 datatype module: state records use Optional<> for genuinely
          optional fields (a system's owner, a fleet's location/enroute path).
          This module teaches Jackson to round-trip Optional as the contained
          value / absent, instead of as a bean. Pure (no I/O); version managed by
          the Spring Boot BOM in the parent reactor.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jdk8</artifactId>
        </dependency>

        <!-- ArchUnit enforces the no-Spring / no-java.io / no-java.net import rule. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Purity guard #1 (artifacts): fail the build if any Spring artifact
              is ever added as a dependency of this framework-free module.
              Purity guard #2 (imports) lives in the ArchUnit test.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-spring-from-engine</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.springframework</exclude>
                                        <exclude>org.springframework.boot</exclude>
                                        <exclude>org.springframework.ai</exclude>
                                        <exclude>org.springframework.*</exclude>
                                        <exclude>org.springframework.ai.*</exclude>
                                    </excludes>
                                    <message>engine is framework-free: no Spring / Spring AI dependencies are permitted.</message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
