<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.stellarcompact</groupId>
        <artifactId>stellar-compact-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>persistence</artifactId>
    <name>Stellar Compact :: persistence</name>
    <description>PostgreSQL repositories + object-store adapter. Depends on engine.</description>

    <dependencies>
        <dependency>
            <groupId>com.stellarcompact</groupId>
            <artifactId>engine</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <!--
              Compile scope: the E5-02 active-set repositories (JdbcClient) need only
              the JDBC API at compile time, but the round-trip Testcontainers test
              constructs a PGSimpleDataSource directly, which requires the driver on
              the (test) compile classpath, so it cannot be runtime-only.
            -->
        </dependency>

        <!--
          Flyway owns the schema. flyway-core runs the versioned V*.sql migrations
          under src/main/resources/db/migration; flyway-database-postgresql is the
          Postgres-specific support module Flyway 11 requires for the postgresql
          dialect. Versions are managed by the Spring Boot BOM in the parent reactor.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Testcontainers spins up a real PostgreSQL in Docker so the migration
          test applies V*.sql against the actual database the app targets and then
          inspects the resulting catalog. testcontainers-postgresql/-junit-jupiter
          are the Testcontainers 2.x coordinates; versions are managed by the
          testcontainers-bom imported transitively via the Spring Boot BOM.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
